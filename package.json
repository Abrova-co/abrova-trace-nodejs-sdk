{
  "name": "@abrova-trace/nodejs-sdk",
  "version": "0.3.1",
  "description": "AbrovaTrace Node.js SDK for server-side error tracking, API tracing and monitoring",
  "main": "index.js",
  "types": "index.d.ts",
  "files": [
    "index.js",
    "lib/**/*.js",
    "index.d.ts",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "example:basic": "node examples/basic-usage.js",
    "example:express": "node examples/express-integration.js",
    "example:database": "node examples/database-example.js",
    "build:tracing": "node scripts/build-tracing.mjs",
    "prepublishOnly": "npm run build:tracing && npm test && npm run lint",
    "docs": "jsdoc -d docs lib/ index.js"
  },
  "keywords": [
    "error-tracking",
    "error-monitoring",
    "crash-reporting",
    "exception-handling",
    "logging",
    "debugging",
    "nodejs",
    "abrova-trace",
    "monitoring",
    "observability",
    "express",
    "middleware",
    "breadcrumbs",
    "stack-trace"
  ],
  "author": {
    "name": "AbrovaTrace Team",
    "email": "support@abrova.ir",
    "url": "https://abrova.ir"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Abrova-co/abrova-trace-nodejs-sdk.git"
  },
  "bugs": {
    "url": "https://github.com/Abrova-co/abrova-trace-nodejs-sdk/issues"
  },
  "homepage": "https://abrova.ir/cloud/abrova-trace",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=14.0.0"
  },
  "peerDependencies": {
    "express": ">=4.0.0"
  },
  "peerDependenciesMeta": {
    "express": {
      "optional": true
    }
  },
  "devDependencies": {
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/core": "2.12.0",
    "@opentelemetry/instrumentation": "0.223.0",
    "@opentelemetry/instrumentation-express": "0.71.1",
    "@opentelemetry/instrumentation-http": "0.223.0",
    "@opentelemetry/instrumentation-ioredis": "0.71.0",
    "@opentelemetry/instrumentation-mongodb": "0.76.0",
    "@opentelemetry/instrumentation-mysql2": "0.69.0",
    "@opentelemetry/instrumentation-nestjs-core": "0.70.0",
    "@opentelemetry/instrumentation-pg": "0.76.0",
    "@opentelemetry/instrumentation-redis": "0.71.0",
    "@opentelemetry/instrumentation-undici": "0.33.0",
    "@opentelemetry/sdk-trace-base": "2.12.0",
    "@opentelemetry/sdk-trace-node": "2.12.0",
    "@types/node": "^18.0.0",
    "esbuild": "0.28.2",
    "eslint": "^8.0.0",
    "jest": "^29.0.0",
    "jsdoc": "^4.0.0",
    "supertest": "^6.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "collectCoverageFrom": [
      "lib/**/*.js",
      "index.js",
      "!**/node_modules/**"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 80,
        "functions": 80,
        "lines": 80,
        "statements": 80
      }
    }
  },
  "eslintConfig": {
    "env": {
      "node": true,
      "es2021": true,
      "jest": true
    },
    "extends": "eslint:recommended",
    "parserOptions": {
      "ecmaVersion": 2022,
      "sourceType": "module"
    },
    "rules": {
      "no-console": "off",
      "no-unused-vars": [
        "error",
        {
          "argsIgnorePattern": "^_"
        }
      ]
    }
  }
}
